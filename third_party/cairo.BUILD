cc_library(
    name = "cairo",
    srcs = [
        "cairo-features.h",
        "config.h",
    ] + CAIRO_SOURCES + CAIRO_HEADERS,
    hdrs = [
        "cairo-version.h",
        "src/cairo.h",
        "src/cairo-deprecated.h",
    ],
    copts = [
        "-Wno-attributes",
        "-Wno-unused-but-set-variable",
        "-Wno-strict-aliasing",
        "-Wno-array-bounds",
        "-Wno-unused-function",
    ] + select({
        ":clang_compiler": [
            "-Wno-enum-conversion",
            "-Wno-ignored-attributes",
            "-Wno-parentheses-equality",
            "-Wno-incompatible-pointer-types",
        ],
        "//conditions:default": [
            "-Wno-maybe-uninitialized",
            "-Wno-stringop-overflow",
        ],
    }),
    includes = ["src"],
    local_defines = [
        "HAVE_CONFIG_H=1",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@pixman",
    ],
)
