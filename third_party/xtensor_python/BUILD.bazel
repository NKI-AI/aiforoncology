cc_library(
    name = "xtensor_python",
    hdrs = glob(["include/xtensor-python/*.hpp"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":numpy_headers",
        "@pybind11",
        "@xtensor",
    ],
)

