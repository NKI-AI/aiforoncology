        '#define PACKAGE_NAME "glib"',
        '#define PACKAGE_STRING "glib {}.{}.{}"'.format(MAJOR_VERSION, MINOR_VERSION, MICRO_VERSION),
        '#define PACKAGE_TARNAME "glib"',
        '#define PACKAGE_URL ""',
        '#define PACKAGE_VERSION "{}.{}.{}"'.format(MAJOR_VERSION, MINOR_VERSION, MICRO_VERSION),
