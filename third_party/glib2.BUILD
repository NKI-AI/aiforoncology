)

cc_library(
    name = "glib_libcharset",
    srcs = [
        "config.h",
        "glib/libcharset/localcharset.c",
        "glib/libcharset/localcharset.h",
    ],
    hdrs = [
        "glib/libcharset/libcharset.h",
    ],
    copts = [
        "-DHAVE_CONFIG_H",
        "-DLIBDIR='\"/nonexistent\"'",
    ],
)

