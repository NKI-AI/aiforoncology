    "gio/gliststore.h",
] + GIO_SETTINGS_HEADERS + GIO_APPLICATION_HEADERS + GIO_GDBUS_HEADERS + GIO_UNIX_HEADERS

expand_template(
    name = "gio_gnetworking_h",
    out = "gio/gnetworking.h",
    substitutions = select({
        "@platforms//os:osx": {
            "@NAMESER_COMPAT_INCLUDE@": "#include <arpa/nameser_compat.h>",
        },
        "//conditions:default": {
            "@NAMESER_COMPAT_INCLUDE@": "#include <resolv.h>",
        },
    }),
    template = "gio/gnetworking.h.in",
)

genrule(
    name = "gio_gioenumtypes_h",
    srcs = ["gio/gioenumtypes.h.template"] + GIO_HEADERS + ["gio/gnetworking.h"],
    outs = ["gio/gioenumtypes.h"],
    cmd = "$(location //:gobject_glib_mkenums_tool) --template $(SRCS) > $@",
    tools = ["//:gobject_glib_mkenums_tool"],
)

genrule(
    name = "gio_gioenumtypes_c",
    srcs = ["gio/gioenumtypes.c.template"] + GIO_HEADERS + ["gio/gnetworking.h"],
    outs = ["gio/gioenumtypes.c"],
    cmd = "$(location //:gobject_glib_mkenums_tool) --template $(SRCS) > $@",
    tools = ["//:gobject_glib_mkenums_tool"],
)

cc_library(
    name = "gio_enumtypes_gio_headers_private",
    hdrs = GIO_HEADERS,
    strip_include_prefix = "gio",
)

cc_system_headers(
    name = "system_headers_gio",
    hdrs = GIO_HEADERS + ["gio/gioenumtypes.h"],
)

cc_library(
    name = "gio_enumtypes_gmodule_headers_private",
    hdrs = ["gmodule/gmodule.h"],
    strip_include_prefix = "gmodule",
)

cc_library(
    name = "gio_enumtypes",
    srcs = [
        "gio/gioenumtypes.c",
    ] + GIO_HEADERS + GIO_HEADERS_PRIVATE,
    hdrs = ["gio/gioenumtypes.h"],
    deps = [
        ":gio_enumtypes_gio_headers_private",
        ":gio_enumtypes_gmodule_headers_private",
        ":gmodule",
        ":gobject",
        ":system_headers_gio",
    ],
)

genrule(
    name = "gio_xdp_dbus_srcs",
    srcs = [
        "gio/org.freedesktop.portal.Documents.xml",
        "gio/org.freedesktop.portal.OpenURI.xml",
        "gio/org.freedesktop.portal.ProxyResolver.xml",
        "gio/org.freedesktop.portal.Trash.xml",
    ],
    outs = [
        "gio/xdp-dbus.h",
        "gio/xdp-dbus.c",
    ],
    cmd = "$(location :gio_gdbus_codegen_tool) " +
          "--interface-prefix org.freedesktop.portal. " +
          "--output-directory $(RULEDIR)/gio " +
          "--generate-c-code xdp-dbus " +
          "--c-namespace GXdp $(SRCS)",
    tools = [":gio_gdbus_codegen_tool"],
)

genrule(
    name = "gio_gdbus_daemon_generated_srcs",
    srcs = ["gio/dbus-daemon.xml"],
    outs = [
        "gio/gdbus-daemon-generated.h",
        "gio/gdbus-daemon-generated.c",
    ],
    cmd = "$(location :gio_gdbus_codegen_tool) " +
          "--interface-prefix org. " +
          "--output-directory $(RULEDIR)/gio " +
          "--generate-c-code gdbus-daemon-generated " +
          "--c-namespace _G $(SRCS)",
    tools = [":gio_gdbus_codegen_tool"],
)

cc_library(
    name = "gio_gdbus_daemon_generated",
    srcs = [
        "gio/gdbus-daemon-generated.c",
    ],
    hdrs = ["gio/gdbus-daemon-generated.h"],
    deps = [
        ":gio_enumtypes",
        ":gobject",
        ":system_headers_config",
    ],
)

cc_library(
    name = "gio_headers_private",
    hdrs = GIO_HEADERS_PRIVATE + [
        "gio/gioenumtypes.h",
        "gio/gnetworking.h",
        "gio/xdp-dbus.h",
    ],
    strip_include_prefix = "gio",
)

cc_system_headers(
    name = "system_headers_gio_private",
    hdrs = GIO_HEADERS_PRIVATE + [
        "gio/gnetworking.h",
    ],
)

cc_library(
    name = "gio",
    srcs = GIO_SOURCES + [
        "gio/xdp-dbus.c",
    ],
    hdrs = GIO_HEADERS,
    copts = [
        "-Wno-address",
        "-Wno-single-bit-bitfield-constant-conversion",
        "-Wno-unused-variable",
    ],
    linkopts = [
        "-lresolv",
    ],
    local_defines = [
        "GIO_COMPILATION=1",
        "LOCALSTATEDIR='\"/nonexistent\"'",
        "GIO_MODULE_DIR='\"/nonexistent\"'",
    ],
    textual_hdrs = [
        "gio/strinfo.c",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gio_enumtypes",
        ":gio_gdbus_daemon_generated",
        ":gio_headers_private",
        ":gio_xdgmime",
        ":glib",
        ":glib_headers_private",
        ":gmodule",
        ":gobject",
        ":system_headers_config",
        ":system_headers_gio",
        ":system_headers_gio_private",
        "@zlib",
    ],
)
