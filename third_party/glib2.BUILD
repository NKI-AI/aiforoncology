GLIB_SUBSTITUTIONS = {
    "#mesondefine GLIB_HAVE_ALLOCA_H": "#define GLIB_HAVE_ALLOCA_H",
    "#mesondefine GLIB_USING_SYSTEM_PRINTF": "#define GLIB_USING_SYSTEM_PRINTF",
    "#mesondefine GLIB_STATIC_COMPILATION": "#define GLIB_STATIC_COMPILATION 1",
    "#mesondefine GOBJECT_STATIC_COMPILATION": "#define GOBJECT_STATIC_COMPILATION 1",
    "#mesondefine G_INTL_STATIC_COMPILATION": "#define G_INTL_STATIC_COMPILATION 1",
    "#mesondefine FFI_STATIC_BUILD": "#define FFI_STATIC_BUILD 1",
    "@gint16@": "short",
    "@gint16_modifier@": '"h"',
    "@gint16_format@": '"hi"',
    "@guint16_format@": '"hu"',
    "@gint32@": "int",
    "@gint32_modifier@": '""',
    "@gint32_format@": '"i"',
    "@guint32_format@": '"u"',
    "@gint64@": "long",
    "@glib_extension@": "",
    "@gint64_constant@": "(val##L)",
    "@guint64_constant@": "(val##UL)",
    "@gint64_modifier@": '"l"',
    "@gint64_format@": '"li"',
    "@guint64_format@": '"lu"',
    "@glib_void_p@": "8",
    "@glib_long@": "8",
    "@glib_size_t@": "8",
    "@glib_ssize_t@": "8",
    "@glib_size_type_define@": "long",
    "@gsize_modifier@": '"l"',
    "@gsize_format@": '"lu"',
    "@gssize_format@": '"li"',
    "@glib_msize_type@": "LONG",
    "@g_pollfd_format@": '"%d"',
    "@glib_gpi_cast@": "(glong)",
    "@glib_gpui_cast@": "(gulong)",
    "@glib_intptr_type_define@": "long",
    "@gintptr_modifier@": '"l"',
    "@gintptr_format@": '"li"',
    "@guintptr_format@": '"lu"',
    "@GLIB_MAJOR_VERSION@": MAJOR_VERSION,
    "@GLIB_MINOR_VERSION@": MINOR_VERSION,
    "@GLIB_MICRO_VERSION@": MICRO_VERSION,
    "@glib_os@": "#define G_OS_UNIX",
    "@glib_vacopy@": "#define G_VA_COPY va_copy\n#define G_VA_COPY_AS_ARRAY 1",
    "@g_have_iso_c_varargs@": "#ifndef __cplusplus\n# define G_HAVE_ISO_VARARGS 1\n#endif",
    "@g_have_iso_cxx_varargs@": "#ifdef __cplusplus\n# define G_HAVE_ISO_VARARGS 1\n#endif",
    "#mesondefine G_HAVE_GROWING_STACK": "#define G_HAVE_GROWING_STACK 0",
    "#mesondefine G_HAVE_GNUC_VISIBILITY": "#define G_HAVE_GNUC_VISIBILITY 1",
    "@g_threads_impl_def@": "POSIX",
    "#mesondefine G_ATOMIC_LOCK_FREE": "#define G_ATOMIC_LOCK_FREE",
    "@g_bs_native@": "LE",
    "@g_bs_alien@": "BE",
    "@glongbits@": "64",
    "@gintbits@": "32",
    "@gsizebits@": "64",
    "@g_byte_order@": "G_LITTLE_ENDIAN",
    "@g_pollin@": "1",
    "@g_pollout@": "4",
    "@g_pollpri@": "2",
    "@g_pollhup@": "16",
    "@g_pollerr@": "8",
    "@g_pollnval@": "32",
    "@g_module_suffix@": "so",
    "@g_pid_type@": "int",
    "@g_pid_format@": '"i"',
    "@g_af_unix@": "1",
    "@g_af_inet@": "2",
    "@g_af_inet6@": "10",
    "@g_msg_oob@": "1",
    "@g_msg_peek@": "2",
    "@g_msg_dontroute@": "4",
    "@g_dir_separator@": "/",
    "@g_searchpath_separator@": ":",
}

expand_template(
    name = "glib_glibconfig_h",
    out = "glibconfig.h",
    substitutions = GLIB_SUBSTITUTIONS,
    template = "glib/glibconfig.h.in",
)

cc_system_headers(
    name = "system_headers_glibconfig",
    hdrs = ["glibconfig.h"],
)

cc_system_headers(
    name = "system_headers_config",
    hdrs = ["config.h"],
)

cc_system_headers(
    name = "system_headers_glib_base",
    hdrs = GLIB_HEADERS_BASE,
)

cc_system_headers(
    name = "system_headers_glib",
    hdrs = GLIB_HEADERS + GLIB_HEADERS_DEPRECATED,
)

cc_library(
    name = "glib_headers_private",
    hdrs = GLIB_HEADERS_BASE + GLIB_HEADERS + GLIB_HEADERS_DEPRECATED + GLIB_HEADERS_PRIVATE,
    strip_include_prefix = "glib",
)

cc_library(
    name = "glib",
    srcs = GLIB_SOURCES_DEPRECATED + GLIB_SOURCES + GLIB_HEADERS_PRIVATE + ["glibconfig.h"],
    copts = [
        "-Wno-unused-result",
    ],
    linkopts = select({
