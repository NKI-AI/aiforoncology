cc_library(
    name = "libnsgif",
    srcs = [
        "src/gif.c",
        "src/lzw.c",
        "src/lzw.h",
    ],
    hdrs = [
        "include/nsgif.h",
        "src/lzw.h",
    ],
    copts = [
        "-DNSGIF_NAME=nsgif",
        "-DNSGIF_VERSION=1.0.0",
        "-Iinclude",
        "-Isrc",
        "-Wall",
        "-Wextra",
        "-W",
        "-Wundef",
        "-Wpointer-arith",
        "-Wcast-align",
        "-Wwrite-strings",
        "-Wstrict-prototypes",
        "-Wmissing-prototypes",
        "-Wmissing-declarations",
        "-Wnested-externs",
        "-pedantic",
        "-std=c99",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = ["@liblzw"],
)
