load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@bazel_skylib//lib:partial.bzl", "partial")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//aifo/slidescope/ui:vite/package_json.bzl", vite_bin = "bin")
load("@rules_go//go:def.bzl", "go_library")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "vite_configs",
    srcs = [
        "index.html",
        "package.json",
        "postcss.config.cjs",
        "vite.config.mjs",
    ],
    visibility = [":__subpackages__"],
)

SRCS = ["//aifo/slidescope/ui/src"]

TYPED_BUILD_DEPS = [":node_modules/" + d for d in [
    "@types/react",
    "@types/react-dom",
    "@types/node",
    "@types/proj4",
    "@types/react-color",
    "@types/swagger-ui-react",
    "@types/reactcss",
    "react",
    "react-dom",
    "react-router-dom",
    "react-color",
    "ol",
    "swagger-ui-react",
    "@headlessui/react",
    "@heroicons/react",
    "jwt-decode",
    "lucide-react",
    "proj4",
    "typescript",
    "@tailwindcss/vite",
    "tailwindcss",
    "autoprefixer",
    "vite-plugin-css-injected-by-js",
    "@vitejs/plugin-react",
    "vite",
]]

ts_project(
    name = "ui",
    srcs = SRCS,
    allow_js = True,
    declaration = True,
    declaration_map = True,
    resolve_json_module = True,
    transpiler = partial.make(
        swc,
        swcrc = ".swcrc",
    ),
    visibility = ["//visibility:public"],
    deps = TYPED_BUILD_DEPS,
)

vite_bin.vite_binary(
    name = "vite",
    chdir = package_name(),
    copy_data_to_bin = False,
)

vite_bin.vite(
    name = "build",
    srcs = [
        "index.html",
        ":ui",
        ":vite_configs",
        "//aifo/slidescope/ui/src",
    ],
    args = ["build"],
    chdir = package_name(),
    out_dirs = ["dist"],
)

go_library(
    name = "ui_lib",
    srcs = ["ui.go"],
    embedsrcs = [":build"],
    importpath = "aifo.dev/aifo/slidescope/ui",
    visibility = ["//visibility:public"],
    deps = ["@com_github_gofiber_fiber_v2//middleware/filesystem"],
)
